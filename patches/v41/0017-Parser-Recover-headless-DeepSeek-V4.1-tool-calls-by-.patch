+    def _begin_headless_from_hold(self) -> list[SemanticEvent]:
+        """Reinterpret a name-less provisional recovery as a headless call.
+
+        The model emitted a tool call with no invoke opener and no tool name,
+        straight into its parameters, so the captured "name" is really the
+        first parameter's opening tag. Keep the buffered TOOL_CALL_START, drop
+        the mistaken TOOL_NAME events, move to TOOL_ARGS, and feed the buffered
+        text so far as argument content. The tool is inferred from the
+        parameters when the call commits (the parser's name-extraction hook);
+        if no `</invoke>` arrives, finish() aborts the hold and the whole block
+        is restored as text like any other unrecovered candidate.
+        """
+        self._recovery_hold_events = [
+            e for e in self._recovery_hold_events if e.type != EventType.TOOL_NAME
+        ]
+        self.state = ParserState.TOOL_ARGS
+        self._recovery_headless = True
+        self._recovery_hold_name = ""
+        if self._recovery_hold_raw:
+            self._recovery_hold_events.append(
+                SemanticEvent(
+                    EventType.ARG_VALUE_CHUNK,
+                    value=self._recovery_hold_raw,
+                    tool_index=self.tool_index,
+                )
+            )
+        return []
+
     def _clear_recovery_hold(self) -> None:
         self._recovery_hold_active = False
         self._recovery_hold_events = []
         self._recovery_hold_raw = ""
         self._recovery_hold_token_count = 0
         self._recovery_hold_name = ""
+        self._recovery_headless = False
 
