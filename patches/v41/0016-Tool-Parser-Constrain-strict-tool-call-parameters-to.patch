diff --git a/vllm/tool_parsers/structural_tag_registry.py b/vllm/tool_parsers/structural_tag_registry.py
index 34e57840be..ad4e92b6ee 100644
--- a/vllm/tool_parsers/structural_tag_registry.py
+++ b/vllm/tool_parsers/structural_tag_registry.py
@@ -233,6 +233,183 @@ _V41_INVOKE_END = "</｜DSML｜ invoke>"
 _V41_PARAMETER_END = "</｜DSML｜ parameter>"
 
 
+_V41_STRING_ATOM = "(?:[^<]|<[^｜])"  # any char, never the start of a DSML marker
+_V41_JSON_TYPES = {"integer", "number", "boolean", "null", "object", "array"}
+_V41_VALUE_EXCLUDES = [_V41_PARAMETER_END, _V41_INVOKE_END, _V41_CALLS_END]
+
+
+def _v41_resolve_ref(schema: Any, root_defs: dict[str, Any]) -> Any:
+    """Follow local ``#/$defs/NAME`` / ``#/definitions/NAME`` references (at most
+    8 hops). A sibling ``type`` next to ``$ref`` wins over the target's."""
+    for _ in range(8):
+        if not isinstance(schema, dict) or "$ref" not in schema:
+            return schema
+        ref = schema["$ref"]
+        target = None
+        if isinstance(ref, str):
+            for prefix in ("#/$defs/", "#/definitions/"):
+                if ref.startswith(prefix):
+                    target = root_defs.get(ref[len(prefix) :])
+        if not isinstance(target, dict):
+            return {k: v for k, v in schema.items() if k != "$ref"} or True
+        merged = dict(target)
+        merged.update({k: v for k, v in schema.items() if k != "$ref"})
+        schema = merged
+    return schema
+
+
+def _v41_attach_root_definitions(schema: Any, root_defs: dict[str, Any]) -> Any:
+    if not root_defs or not isinstance(schema, dict):
+        return schema
+    out = dict(schema)
+    out.setdefault("$defs", {}).update(
+        {k: v for k, v in root_defs.items() if k not in out["$defs"]}
+    )
+    return out
+
+
+def _v41_permissive_value() -> OrFormat:
+    """The pre-schema behaviour: the model picks raw text or any JSON."""
+    return OrFormat(
+        elements=[
+            SequenceFormat(
+                elements=[
+                    ConstStringFormat(value='true">'),
+                    AnyTextFormat(excludes=_V41_VALUE_EXCLUDES),
+                ]
+            ),
+            SequenceFormat(
+                elements=[
+                    ConstStringFormat(value='false">'),
+                    JSONSchemaFormat(json_schema=True),
+                ]
+            ),
+        ]
+    )
+
+
+def _v41_permissive_parameter() -> TagFormat:
+    """Any parameter name, any value (the builder before schema lowering)."""
+    return TagFormat(
+        begin='<｜DSML｜ parameter name="',
+        content=SequenceFormat(
+            elements=[
+                RegexFormat(pattern=r'[^"]+'),
+                ConstStringFormat(value='" string="'),
+                _v41_permissive_value(),
+            ]
+        ),
+        end=f"{_V41_PARAMETER_END}\n",
+    )
+
+
+def _v41_string_value(schema: dict[str, Any]) -> Any:
+    """Raw-channel string value: enum/const literals, a pattern, length bounds,
+    else any text that does not contain a closing marker."""
+    literals = schema.get("enum")
+    if literals is None and "const" in schema:
+        literals = [schema["const"]]
+    if (
+        isinstance(literals, list)
+        and literals
+        and len(literals) <= 256
+        and all(isinstance(v, str) and "<｜" not in v for v in literals)
+    ):
+        return OrFormat(elements=[ConstStringFormat(value=v) for v in literals])
+    pattern = schema.get("pattern")
+    if isinstance(pattern, str) and pattern:
+        return RegexFormat(pattern=pattern)
+    min_len, max_len = schema.get("minLength"), schema.get("maxLength")
+    if isinstance(min_len, int) or isinstance(max_len, int):
+        lo = min_len if isinstance(min_len, int) and min_len > 0 else 0
+        hi = str(max_len) if isinstance(max_len, int) else ""
+        return RegexFormat(pattern=f"{_V41_STRING_ATOM}{{{lo},{hi}}}")
+    return AnyTextFormat(excludes=_V41_VALUE_EXCLUDES)
+
+
+def _v41_parameter_tag(
+    name: str, schema: Any, root_defs: dict[str, Any]
+) -> TagFormat:
+    """One ``<｜DSML｜ parameter name="NAME" string="...">VALUE</｜DSML｜ parameter>``
+    whose VALUE follows the parameter's JSON schema (vLLM PR #56235's rules,
+    Rust frontend, mirrored here for the Python builder):
+
+    * ``type: string`` → raw text: enum/const literals, ``pattern``, or
+      ``minLength``/``maxLength`` bounds, else any marker-free text.
+    * integer/number/boolean/null/object/array → the sub-schema as JSON
+      (objects closed unless ``additionalProperties`` allows more, per xgrammar).
+    * anything else (no type, mixed unions, ``false``) → unconstrained, i.e.
+      the model picks raw text or any JSON.
+    The ``string="true|false"`` flag is accepted in either form; only the
+    value is constrained.
+    """
+    schema = _v41_resolve_ref(schema, root_defs)
+    if isinstance(schema, dict) and "$defs" in schema:
+        root_defs = {**root_defs, **schema["$defs"]}
+    flag = OrFormat(
+        elements=[ConstStringFormat(value='true">'), ConstStringFormat(value='false">')]
+    )
+    value: Any
+    if isinstance(schema, dict):
+        typ = schema.get("type")
+        if typ == "string" or (typ is None and ("enum" in schema or "const" in schema)):
+            value = _v41_string_value(schema)
+            if typ is None and not isinstance(value, OrFormat):
+                value = None
+        elif isinstance(typ, str) and typ in _V41_JSON_TYPES:
+            value = JSONSchemaFormat(
+                json_schema=_v41_attach_root_definitions(schema, root_defs)
+            )
+        else:
+            value = None
+    else:
+        value = None
+    if value is None:
+        content: Any = SequenceFormat(
+            elements=[ConstStringFormat(value='" string="'), _v41_permissive_value()]
+        )
+    else:
+        content = SequenceFormat(
+            elements=[ConstStringFormat(value='" string="'), flag, value]
+        )
+    return TagFormat(
+        begin=f'<｜DSML｜ parameter name="{name}',
+        content=content,
+        end=f"{_V41_PARAMETER_END}\n",
+    )
+
+
+def _v41_invoke_content(tool: FunctionToolParam) -> Any:
+    """The parameter block of one invoke: schema-ordered parameters, required
+    ones mandatory, optional ones skippable; extra names only when the schema
+    allows ``additionalProperties``. Non-strict and schema-less tools keep the
+    unconstrained block."""
+    fn = tool.function
+    params = getattr(fn, "parameters", None)
+    strict = getattr(fn, "strict", None)
+    if params is False:
+        return ConstStringFormat(value="")
+    # Only strict tools get the schema lowering: OpenAI's strict defaults to
+    # false, and non-strict tools keep the name-and-syntax-only grammar (the
+    # request layer likewise only activates auto-mode grammars for strict tools).
+    if strict is not True or not isinstance(params, dict):
+        return StarFormat(content=_v41_permissive_parameter())
+    root_defs = dict(params.get("$defs") or params.get("definitions") or {})
+    props = params.get("properties")
+    if not isinstance(props, dict):
+        return StarFormat(content=_v41_permissive_parameter())
+    required = set(params.get("required") or [])
+    elements: list[Any] = []
+    for key, sub in props.items():
+        tag = _v41_parameter_tag(key, sub, root_defs)
+        elements.append(tag if key in required else OptionalFormat(content=tag))
+    if params.get("additionalProperties") is True:
+        elements.append(StarFormat(content=_v41_permissive_parameter()))
+    if not elements:
+        return ConstStringFormat(value="")
+    return SequenceFormat(elements=elements)
+
+
 @register_vllm_structural_tag("deepseek_v41")
 def get_deepseek_v41_structural_tag(
     tools: list[FunctionToolParam],
@@ -244,47 +421,15 @@ def get_deepseek_v41_structural_tag(
