+_SAFETENSORS_DTYPES = {
+    "BF16": torch.bfloat16,
+    "F16": torch.float16,
+    "F32": torch.float32,
+    "F64": torch.float64,
+    "I8": torch.int8,
+    "U8": torch.uint8,
+    "I16": torch.int16,
+    "I32": torch.int32,
+    "I64": torch.int64,
+    "BOOL": torch.bool,
+    "F8_E4M3": torch.float8_e4m3fn,
+    "F8_E5M2": torch.float8_e5m2,
+    "F8_E8M0": getattr(torch, "float8_e8m0fnu", torch.uint8),
+}
+
+
+def _safetensors_header(st_file: str) -> tuple[dict, int]:
+    """(header dict, byte offset of the data section) without mapping the file."""
+    with open(st_file, "rb") as f:
+        (header_len,) = struct.unpack("<Q", f.read(8))
+        header = json.loads(f.read(header_len))
+    header.pop("__metadata__", None)
+    return header, 8 + header_len
+
+
+def _read_tensors_without_mmap(
+    st_file: str, header: dict, data_start: int, names: list[str]
+) -> Generator[tuple[str, torch.Tensor], None, None]:
+    """Read selected tensors with plain ``pread``.
+
+    ``safe_open`` maps the whole file privately through PyTorch's
+    MapAllocator; for a shard that is mostly one huge skipped tensor (the
+    98 GiB DeepSeek V4.1 Engram tables) that mapping is refused by the
+    kernel's overcommit heuristic on hosts with less RAM+swap than the
+    file, even though none of it would ever be touched.
+    """
+    with open(st_file, "rb") as f:
+        for name in names:
+            meta = header[name]
+            start, end = meta["data_offsets"]
+            f.seek(data_start + start)
+            buf = f.read(end - start)
+            dtype = _SAFETENSORS_DTYPES[meta["dtype"]]
+            tensor = (
+                torch.frombuffer(bytearray(buf), dtype=torch.uint8)
+                .view(dtype)
+                .reshape(meta["shape"])
+            )
+            yield name, tensor
+
+
 def safetensors_weights_iterator(
     hf_weights_files: list[str],
     use_tqdm_on_load: bool,
@@ -981,6 +1034,19 @@ def safetensors_weights_iterator(
                 )
             yield from unflattened_state_dict.items()
         else:
+            if _SKIP_WEIGHT_NAMES:
+                header, data_start = _safetensors_header(st_file)
+                if any(_skip_registered_weight(n) for n in header):
+                    wanted = [
+                        n
+                        for n in header
+                        if not _skip_registered_weight(n)
+                        and not should_skip_weight(n, local_expert_ids)
+                    ]
+                    yield from _read_tensors_without_mmap(
+                        st_file, header, data_start, wanted
+                    )
+                    continue
             with safe_open(st_file, framework="pt") as f:
                 for name in f.keys():  # noqa: SIM118
                     if should_skip_weight(name, local_expert_ids):
